# Public URL of the site (used in emails, Stripe redirects; https turns on Secure cookies and HSTS)
CHOPLAB_BASE_URL=https://your-domain.example
# Set to 1 only when running behind your own reverse proxy that sets X-Forwarded-For
CHOPLAB_TRUST_PROXY=1
# Background workers for analysis/generation (roughly one per CPU core you can spare)
CHOPLAB_WORKERS=2

# Stripe (leave unset to run without paid plans)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=

# Outgoing email for password resets (without it, reset links are only written to the server log)
CHOPLAB_SMTP_HOST=
CHOPLAB_SMTP_PORT=587
CHOPLAB_SMTP_USER=
CHOPLAB_SMTP_PASSWORD=
CHOPLAB_MAIL_FROM=ChopLab <no-reply@your-domain.example>

# Running it just for yourself? This unlocks everything and removes the sign-up wall.
# CHOPLAB_SELF_HOSTED=1
